<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa la información del servicio"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del servicio"
            android:inputType="text"
            android:background="@drawable/background_input_modal"
            android:minHeight="48dp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Descripción"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcionDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe el servicio"
            android:inputType="textMultiLine"
            android:background="@drawable/background_input_modal"
            android:minLines="2"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Costo"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCostoDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:background="@drawable/background_input_modal"
            android:minHeight="48dp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Categoría"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategoriaDialogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_input_modal"
            android:minHeight="48dp"
            android:padding="4dp" />

        <CheckBox
            android:id="@+id/cbEstadoDialogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Servicio activo" />
    </LinearLayout>
</ScrollView>
